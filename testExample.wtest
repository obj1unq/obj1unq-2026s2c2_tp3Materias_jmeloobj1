import example.*

describe "Inscripción a carreras" {

 const bd = new Materia(nombreMateria = "Bases de Datos")
  const psicologia = new Materia(nombreMateria = "Psicología")
  const programacion = new Carrera(nombreCarrera = "Programación", materias = #{bd})
  const tuess = new Carrera(nombreCarrera = "TUESS")
  const to = new Carrera(nombreCarrera = "TO", materias = #{psicologia})
  const alex = new Estudiante(nombreEstudiante = "Alex")

  method initialize() {
    alex.inscribirseACarrera(programacion)
    alex.inscribirseACarrera(tuess)
  }

  test "Alex está en Programación y TUESS, no en TO" {
    assert.that(alex.estaInscriptoEn(programacion))
    assert.that(alex.estaInscriptoEn(tuess))
    assert.notThat(alex.estaInscriptoEn(to))
  }

  test "BD pertenece a sus carreras, Psicología no" {
    assert.that(alex.carreraTieneAMateria(bd))
    assert.notThat(alex.carreraTieneAMateria(psicologia))
  }

  test "no puede inscribirse dos veces a Programación" {
    assert.throwsException({ alex.inscribirseACarrera(programacion) })
  }

   test"HistoriaAcademica"{
    const historiaAcademicaAlex = new HistoriaAcademica( estudiante = alex)

    historiaAcademicaAlex.registrarCursada(mate1, 2)
    historiaAcademicaAlex.registrarCursada(objetos1, 10)
    historiaAcademicaAlex.registrarCursada(economia, 6)
    historiaAcademicaAlex.registrarCursada(tys, 8)
    historiaAcademicaAlex.registrarCursada(mate1, 8)
    historiaAcademicaAlex.registrarCursada(bd, 2)
    
    assert.equals(2, historiaAcademicaAlex.ordenDeCursadaDeMateria(mate1).size())
    assert.equals(1, historiaAcademicaAlex.ordenDeCursadaDeMateria(objetos1).size())
    assert.equals(1, historiaAcademicaAlex.ordenDeCursadaDeMateria(economia).size())
    assert.equals(1, historiaAcademicaAlex.ordenDeCursadaDeMateria(tys).size())
    assert.equals(1, historiaAcademicaAlex.ordenDeCursadaDeMateria(bd).size())

    
    historiaAcademicaAlex.registrarCursada(mate1, 7)
    assert.equals(2, historiaAcademicaAlex.cursadasDeMateria(mate1).size())

  }
}